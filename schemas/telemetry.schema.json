{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/av-fleet-sim/telemetry.schema.json",
  "title": "Virtual Vehicle Telemetry",
  "description": "Telemetry published by a SOFTWARE-SIMULATED autonomous vehicle on MQTT topic fleet/{vehicle_id}/telemetry. All values are generated by the simulator; no physical sensors are involved.",
  "type": "object",
  "required": [
    "schema_version",
    "message_id",
    "vehicle_id",
    "sequence",
    "timestamp",
    "location",
    "battery",
    "lidar",
    "radar",
    "camera",
    "vehicle",
    "traffic"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "message_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique per message; used by Node-RED for de-duplication and by MongoDB as an idempotency key"
    },
    "vehicle_id": {
      "type": "string",
      "pattern": "^vehicle-\\d{5,6}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "description": "Per-vehicle monotonically increasing counter (gap/out-of-order detection)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC generation time at the virtual vehicle (ISO-8601, ms precision). Used for end-to-end latency."
    },
    "location": {
      "type": "object",
      "required": [
        "latitude",
        "longitude",
        "speed_kmh",
        "heading"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "altitude_m": {
          "type": "number",
          "minimum": -500,
          "maximum": 9000
        },
        "speed_kmh": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "heading": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "accuracy_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000
        },
        "gps_status": {
          "type": "string",
          "enum": [
            "OK",
            "DEGRADED",
            "FAILED"
          ]
        },
        "fix": {
          "type": "string",
          "enum": [
            "GNSS",
            "DEAD_RECKONING"
          ]
        }
      }
    },
    "battery": {
      "type": "object",
      "required": [
        "percentage",
        "charging"
      ],
      "properties": {
        "percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "charging": {
          "type": "boolean"
        },
        "estimated_range_km": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000
        }
      }
    },
    "lidar": {
      "type": "object",
      "required": [
        "status",
        "obstacle_detected",
        "distance_m",
        "object_count"
      ],
      "description": "Simplified LiDAR summary (nearest return + object count), not a point cloud. Values are null when status=FAILED.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "OK",
            "DEGRADED",
            "FAILED"
          ]
        },
        "obstacle_detected": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "distance_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 300
        },
        "object_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "radar": {
      "type": "object",
      "required": [
        "status",
        "object_detected",
        "distance_m",
        "relative_speed_mps"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "OK",
            "DEGRADED",
            "FAILED"
          ]
        },
        "object_detected": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "distance_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 300
        },
        "relative_speed_mps": {
          "type": [
            "number",
            "null"
          ],
          "description": "Object speed relative to ego along heading; negative = closing"
        }
      }
    },
    "camera": {
      "type": "object",
      "required": [
        "status",
        "object_detected",
        "object_type",
        "confidence"
      ],
      "description": "Camera perception metadata only - no video frames.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "OK",
            "DEGRADED",
            "FAILED"
          ]
        },
        "object_detected": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "object_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "pedestrian",
            "vehicle",
            "bicycle",
            "traffic_light",
            "road_sign",
            "obstacle",
            "road_barrier",
            null
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "safety": {
      "type": "object",
      "properties": {
        "time_to_collision_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "emergency_braking": {
          "type": "boolean"
        },
        "deceleration_mps2": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "vehicle": {
      "type": "object",
      "required": [
        "status",
        "passenger_count"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "AVAILABLE",
            "IN_SERVICE",
            "IDLE",
            "CHARGING",
            "MAINTENANCE",
            "EMERGENCY"
          ]
        },
        "activity": {
          "type": "string",
          "enum": [
            "PARKED",
            "TRIP",
            "CRUISING",
            "REPOSITIONING",
            "EN_ROUTE_TO_CHARGER",
            "CHARGING",
            "OUT_OF_SERVICE",
            "EMERGENCY_STOP"
          ]
        },
        "passenger_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "trip_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "route_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "route_deviation_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "odometer_km": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "traffic": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "LOW",
            "MODERATE",
            "HIGH",
            "CONGESTED"
          ]
        },
        "congestion_index": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "simulation": {
      "type": "object",
      "properties": {
        "simulated": {
          "const": true
        },
        "mode": {
          "type": "string",
          "enum": [
            "demo",
            "normal",
            "load_test"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "vehicle": {
            "properties": {
              "status": {
                "const": "IN_SERVICE"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "vehicle": {
            "properties": {
              "passenger_count": {
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "vehicle": {
            "properties": {
              "status": {
                "enum": [
                  "AVAILABLE",
                  "IDLE",
                  "CHARGING",
                  "MAINTENANCE"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "vehicle": {
            "properties": {
              "passenger_count": {
                "const": 0
              }
            }
          }
        }
      }
    }
  ]
}