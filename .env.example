# =====================================================================
# AV Fleet - software simulation of an autonomous-vehicle fleet
# Copy to .env and adjust. No code changes are needed between runs.
# =====================================================================

# ---- Simulator --------------------------------------------------------
MODE=demo                     # demo | normal | load_test
VEHICLE_COUNT=20              # e.g. 10, 100, 1000, 10000
TELEMETRY_INTERVAL=1          # seconds between telemetry messages per vehicle
EMERGENCY_EVENT_RATE=0        # probability per vehicle per cycle (e.g. 0.001); demo mode uses a script instead
LOW_BATTERY_THRESHOLD=20
CRITICAL_BATTERY_THRESHOLD=10
MQTT_CONNECTION_MODE=         # blank = mode default (demo: per_vehicle, others: shared)
VEHICLES_PER_CONNECTION=250
FAILURE_RATE=0                # random sensor failure/degradation probability per vehicle per cycle
DUPLICATE_RATE=0              # fraction of telemetry sent twice (Node-RED must drop the copy)
MALFORMED_RATE=0              # fraction of telemetry replaced by an invalid frame (-> DLQ)
RANDOM_SEED=
LOG_LEVEL=INFO

# ---- MQTT (Mosquitto) -------------------------------------------------
MQTT_BROKER=mosquitto
MQTT_PORT=1883
# passwords must match mosquitto/config/passwd (regenerate with scripts/gen-mqtt-passwords.sh)
MQTT_SIM_USERNAME=simulator
MQTT_SIM_PASSWORD=sim-dev-password
MQTT_NODERED_USERNAME=nodered
MQTT_NODERED_PASSWORD=nodered-dev-password

# ---- Kafka -------------------------------------------------------------
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC_TELEMETRY=vehicle.telemetry
KAFKA_TOPIC_EVENTS=vehicle.events
KAFKA_TOPIC_ALERTS=vehicle.alerts
KAFKA_TOPIC_DLQ=vehicle.dlq
KAFKA_TELEMETRY_PARTITIONS=6

# ---- MongoDB -----------------------------------------------------------
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=root-dev-password
MONGO_APP_USER=fleet_app
MONGO_APP_PASSWORD=fleet-app-dev-password
MONGODB_URI=mongodb://fleet_app:fleet-app-dev-password@mongodb:27017/fleet?authSource=fleet
MONGODB_DB=fleet
TELEMETRY_TTL_DAYS=7
# AWS deployment only (deploy/aws/docker-compose.atlas.yml): MongoDB Atlas connection string
ATLAS_URI=

# ---- Redis -------------------------------------------------------------
REDIS_PASSWORD=redis-dev-password
REDIS_URI=redis://:redis-dev-password@redis:6379/0

# ---- Backend API -------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
API_USERS=admin:admin123:admin,operator:operator123:operator,viewer:viewer123:viewer
CORS_ORIGINS=http://localhost:8000

# ---- Grafana -----------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin
